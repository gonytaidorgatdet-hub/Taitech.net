{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev:full",
  "framework": "vite",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": "@gofinance-render.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://@gofinance-render.onrender.com/api/:path*"
    }
  ]
}
